    <gnodes xsi:type="com.gebautomation.graphmodel:Annotation" position="36;0" size="565;73" localId="137" comment="Two sensors in a parking lot detect when a car passes towards the outdoor, and lights a warning for 5 seconds.&#xD;&#xA;The sensors are ON (TRUE,1) when oclusion is detected.&#xD;&#xA;The upper sensor is the &quot;external&quot; one - the closest to the door. The light turns on (for 5 seconds) for either &#xD;&#xA;a rising edge on the external with the internal ON, or a falling edge in the internal with the external ON."/>
    <gnodes xsi:type="com.gebautomation.graphmodel:Annotation" position="48;96" size="97;49" localId="177" comment="External Sensor&#xD;&#xA;%IX54.1"/>
