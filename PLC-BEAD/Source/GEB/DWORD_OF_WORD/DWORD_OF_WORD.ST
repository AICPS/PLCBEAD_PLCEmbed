FUNCTION DWORD_OF_WORD:DWORD

	VAR_INPUT
		W1 :	WORD;
		W0 :	WORD;
	END_VAR

	DWORD_OF_WORD := SHL(WORD_TO_DWORD(W1),16) OR WORD_TO_DWORD(W0);

END_FUNCTION

PROGRAM program0
  VAR
    LocalVar0 : WORD;
	LocalVaR1  : WORD;
	LocalOUT  : DWORD;
  END_VAR
  	LocalOUT := DWORD_OF_WORD(LocalVar0, LocalVaR1 );
END_PROGRAM

