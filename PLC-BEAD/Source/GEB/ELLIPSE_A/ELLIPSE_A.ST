FUNCTION ELLIPSE_A:REAL
	VAR_INPUT
		R1  :	REAL;
		R2 :	REAL;
	END_VAR

	ELLIPSE_A := 3.14159265358979323846264338327950288 * R1  * R2;

END_FUNCTION

PROGRAM program0
  VAR
    LocalVar0 : REAL;
	LocalVaR1  : REAL;
	  LocalOUT  : REAL;
  END_VAR
  	LocalOUT := ELLIPSE_A(LocalVar0, LocalVaR1 );
END_PROGRAM

